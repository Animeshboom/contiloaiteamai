# Frontend build-time variables. Everything prefixed VITE_ is PUBLIC: it is compiled into the
# JavaScript bundle that every visitor downloads. Never put secrets here.

# Origin of the StudioTrack API, no trailing slash and no /api suffix.
#   Local dev (npm run dev) and Docker: leave EMPTY - requests go to same-origin /api and are proxied.
#   Cloudflare Pages: set in the Pages dashboard, e.g. https://studiotrack-api.onrender.com
VITE_API_BASE_URL=

# Local dev only: where the Vite dev server proxies /api (default http://localhost:8000)
# VITE_API_PROXY=http://localhost:8000

# Supabase Auth (optional). Leave empty to use the built-in sign-in (local mode).
# Turn on together with AUTH_PROVIDER=supabase in the backend. The publishable key is public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# People without email sign in with an Employee ID; must match LOGIN_ID_EMAIL_DOMAIN in the backend.
VITE_LOGIN_ID_EMAIL_DOMAIN=staff.studiotrack.app
