# Copy to .env and adjust. Never commit real secrets.

ENVIRONMENT=development            # development | test | production
DATABASE_URL=postgresql+psycopg://studiotrack:studiotrack@localhost:5434/studiotrack
POSTGRES_PASSWORD=studiotrack      # used by docker-compose

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# List values are JSON arrays
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
STUDIO_TIMEZONE=Asia/Kolkata
EOD_DEADLINE_HOUR=19

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# AI report narrative (optional — without a key, reports use a deterministic template)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Email & notifications (Gmail MCP) ----
# The backend sends all email through the Gmail MCP server (spawned over stdio, or GMAIL_MCP_URL over HTTP),
# which uses the real Gmail API. Setup: docs/GMAIL_SETUP.md
EMAIL_PROVIDER=mcp
GMAIL_BACKEND=gmail
GMAIL_CREDENTIALS_FILE=           # OAuth client JSON (Desktop app) from Google Cloud Console
GMAIL_TOKEN_FILE=                 # where `python -m gmail_mcp.authorize` stores the user token
# On hosts without files (Render, Railway) put the JSON contents in env vars instead:
# GMAIL_CREDENTIALS_JSON=
# GMAIL_TOKEN_JSON=
EMAIL_SENDER=                     # optional display address; Gmail sends as the authorized account
GMAIL_MCP_URL=                    # e.g. http://gmail-mcp:8765/mcp to use HTTP instead of stdio
# Shared by backend and MCP server; signs report-send approvals. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(36))"
EMAIL_APPROVAL_SECRET=change-me-to-a-long-random-string-at-least-32-chars
APP_BASE_URL=http://localhost:5173   # public URL of the web app; used for links in emails
DEADLINE_REMINDER_HOURS=2

# ---- First administrator ----
# Created at container start if set and not already present. Delete ADMIN_PASSWORD after first sign-in.
# Locally: cd backend && python -m scripts.create_admin --email you@studio.com --name "Your Name"
ADMIN_EMAIL=
ADMIN_PASSWORD=                   # min 12 characters
ADMIN_NAME=
